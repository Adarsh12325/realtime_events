# ==============================================================================
# Real-Time Event Ingestion Pipeline - Environment Configuration Template
# ==============================================================================

# Kafka Cluster Configuration
# In Docker Compose, the internal hostname is 'kafka:9092'.
# If running producer/consumer locally outside Docker, use 'localhost:29092' or 'localhost:9092'.
KAFKA_BROKER_URL=kafka:9092

# Target Kafka Topic for ingested telemetry events
KAFKA_TOPIC=raw_events

# Consumer Group Identifier for offset tracking and horizontal scaling
CONSUMER_GROUP_ID=event_processing_group

# Kafka Consumer Offset Reset Strategy ('earliest' or 'latest')
AUTO_OFFSET_RESET=earliest

# Enable automatic offset committing ('true' or 'false')
ENABLE_AUTO_COMMIT=true

# Producer HTTP Service Configuration
PRODUCER_HOST=0.0.0.0
PRODUCER_PORT=5000

# Logging Level ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# Resilience & Retry Configuration for Kafka Brokers
KAFKA_RETRIES=10
KAFKA_RETRY_BACKOFF_MS=2000
REQUEST_TIMEOUT_SECONDS=10.0

# Consumer Output Persistence Sink
OUTPUT_LOG_PATH=/app/data/processed_events.log
